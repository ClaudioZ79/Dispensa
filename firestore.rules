rules_version = '2';

// Database riservato alle persone autorizzate: si accede solo con account Google
// le cui email sono nell'elenco qui sotto (nel repo pubblico sono segnaposto).
service cloud.firestore {
  match /databases/{database}/documents {
    function autorizzato() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['EMAIL_1', 'EMAIL_2'];  // segnaposto: sostituire con le email autorizzate prima del deploy
    }
    match /cibi/{id} {
      allow read, delete: if autorizzato();
      allow create, update: if autorizzato()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80;
    }
    match /spesa/{id} {
      allow read, delete: if autorizzato();
      allow create, update: if autorizzato()
        && request.resource.data.nome is string
        && request.resource.data.nome.size() > 0
        && request.resource.data.nome.size() <= 80;
    }
  }
}
